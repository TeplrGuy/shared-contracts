{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TeplrGuy/shared-contracts/contracts/models/order.v1.schema.json",
  "title": "Order v1",
  "type": "object",
  "required": ["orderId", "orderNumber", "status", "item", "customerName", "createdAt", "updatedAt"],
  "properties": {
    "orderId": { "type": "string", "minLength": 1 },
    "orderNumber": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["new_order", "in_production", "shipped", "cancelled", "rejected", "draft"]
    },
    "item": { "type": "string", "minLength": 1 },
    "customerName": { "type": "string", "minLength": 1 },
    "shippingService": { "enum": ["standard", "express", "overnight"] },
    "trackingCode": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
